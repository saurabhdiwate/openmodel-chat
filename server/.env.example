# =============================================================================
# OpenModel Chat — Server Environment Configuration
# =============================================================================
# Copy this file to server/.env and adjust values as needed.
# The encryption key is auto-generated on first run if not provided.

# ─── Application ─────────────────────────────────────────────────────────────

# Server port (default: 8787)
PORT=8787

# Frontend URL for CORS in production (e.g., https://chat.example.com)
APP_URL=http://localhost:3000

# Trust proxy headers (set to true behind Nginx/Caddy/Load balancer)
TRUST_PROXY=false

# ─── Database ────────────────────────────────────────────────────────────────

# SQLite database path (relative to server/ or absolute)
DATABASE_URL=sqlite://./data/chat.db

# ─── Security ────────────────────────────────────────────────────────────────

# AES-256-GCM encryption key for provider API keys (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Auto-generated on first run if empty.
API_KEY_ENCRYPTION_KEY=

# ─── AI Providers ────────────────────────────────────────────────────────────

# Ollama base URL (for local model support)
# Default: http://localhost:11434
# In Docker: http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Provider API keys can also be added via the Admin Panel UI
# and are stored encrypted in the database.
